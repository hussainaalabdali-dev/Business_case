// Cloudflare Worker "business-case": static site + /api/* (save/load projects only; no calculations).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "business-case",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "business-case-db",
      "database_id": "3de62444-5d56-4d3c-b600-917ea8adf3d4",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Not secrets. Fill from Zero Trust → Access → Applications → business-case.
  // While empty, /api/* answers 503 (fails closed).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "preview_urls": false,
  "workers_dev": true
}
